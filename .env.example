# Endpoint para onde o formulário de solicitação de assessoria envia os dados.
# Pode ser um Google Apps Script Web App, um formulário do Formspree, um endpoint
# do Supabase (Edge Function / REST) ou um Webhook do n8n/Make/Zapier.
# Veja src/lib/submitAssessoria.ts para o formato esperado do payload.
VITE_ASSESSORIA_WEBHOOK_URL=

# Opcional: token de acesso do Instagram Basic Display / Graph API para trazer
# posts reais no lugar do fallback estático. Veja src/components/InstagramFeed.tsx.
VITE_INSTAGRAM_ACCESS_TOKEN=
